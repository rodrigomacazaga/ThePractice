// ============================================================
// The Practice — Data model
// Multi-location, multi-role desde el día uno.
// Dinero: SIEMPRE en centavos (Int). Créditos: Float (1.0, 1.5, 2.0).
// ============================================================

generator client {
  provider = "prisma-client-js"
  // "native" para desarrollo local; rhel-openssl-3.0.x para las funciones
  // serverless de Netlify (Amazon Linux). Sin esto, el build genera solo el
  // engine de Ubuntu y Prisma falla al inicializar en runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// Usuarios y roles
// ------------------------------------------------------------

enum UserRole {
  CLIENT
  PRACTITIONER
  ADMIN
  SUPER_ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  phone        String?
  role         UserRole  @default(CLIENT)
  image        String?
  emailVerifiedAt DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  practitionerProfile PractitionerProfile?
  clientProfile       ClientProfile?
  payments            Payment[]
  notifications       Notification[]
  auditLogs           AuditLog[]        @relation("actor")
  createdBookings     Booking[]         @relation("bookingCreator")
  reviewedDocuments   Document[]        @relation("documentReviewer")
  incidents           Incident[]        @relation("incidentReporter")
  employee            Employee?
  // Rol con facultades finas, por encima del enum. null = solo el enum.
  roleId              String?
  customRole          Role?             @relation(fields: [roleId], references: [id])
  permissionOverrides UserPermissionOverride[]
  expensesCreated     Expense[]         @relation("expenseAuthor")
  receiptsUploaded    ExpenseReceipt[]  @relation("receiptUploader")

  @@index([role])
  @@index([roleId])
}

// ------------------------------------------------------------
// Practitioners
// ------------------------------------------------------------

enum VerificationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  NEEDS_UPDATE
}

enum Modality {
  IN_PERSON
  ONLINE
  HYBRID
}

enum MicrositeTier {
  BASIC
  PRO
  PREMIUM
  FEATURED
}

model PractitionerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug               String             @unique
  headline           String? // "Psicóloga clínica · Ansiedad y burnout"
  bio                String?
  specialties        String[] // ["Psicología clínica", "Terapia de pareja"]
  languages          String[]           @default(["Español"])
  modality           Modality           @default(IN_PERSON)
  yearsExperience    Int?
  sessionPriceFromCents Int? // "desde $900 MXN"
  sessionPriceToCents   Int?
  acceptingClients   Boolean            @default(true)
  featured           Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING_REVIEW)
  photoUrl           String?
  credentialsText    String? // cédula, formación — texto público
  policiesText       String? // políticas de cancelación del practitioner
  approvedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  locations       PractitionerLocation[]
  membership      PractitionerMembership?
  wallet          CreditWallet?
  bookings        Booking[]              @relation("practitionerBookings")
  services        PractitionerService[]
  availability    Availability[]
  recurring       RecurringBooking[]
  documents       Document[]
  microsite       Microsite?
  reviews         Review[]
  favoritedBy     Favorite[]
  lockers         Locker[]
  addOns          PractitionerAddOn[]
  packagePurchases PackagePurchase[]
  leads           Lead[]                 @relation("practitionerLeads")
  demandSignals   DemandSignal[]

  @@index([featured, verificationStatus])
  @@index([verificationStatus])
}

model ClientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthYear Int?
  notes     String?
  createdAt DateTime @default(now())

  favorites Favorite[]
  bookings  Booking[] @relation("clientBookings")
  reviews   Review[]
}

model Favorite {
  clientId       String
  practitionerId String
  createdAt      DateTime            @default(now())
  client         ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@id([clientId, practitionerId])
}

// ------------------------------------------------------------
// Ubicaciones y salas
// ------------------------------------------------------------

enum LocationStatus {
  OPEN
  PRESALE // en preventa: reservable por founders, visible como "Preventa"
  COMING_SOON
  CLOSED
}

model Location {
  id          String         @id @default(cuid())
  slug        String         @unique // "la-ceiba"
  name        String // "The Practice La Ceiba"
  shortName   String // "La Ceiba"
  city        String
  state       String
  address     String?
  description String?
  status      LocationStatus @default(COMING_SOON)
  timezone    String         @default("America/Mexico_City")
  photos      String[]
  amenities   String[] // ["Recepción compartida", "WiFi", "Coffee station"]
  openingHour Int            @default(7) // 7:00
  closingHour Int            @default(22) // 22:00
  /// Sede fundadora de la red. Es un atributo de la ubicación, no una regla
  /// sobre su slug: cualquier sede puede serlo y ninguna lo es por su nombre.
  isFounding  Boolean        @default(false)
  sort        Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  rooms         Room[]
  roomTypes     RoomType[]
  practitioners PractitionerLocation[]
  bookings      Booking[]
  lockers       Locker[]
  incidents     Incident[]
  leads         Lead[]
  payments      Payment[]
  expenses      Expense[]
  employees     Employee[]
  demandSignals DemandSignal[]
  rateWindows   RateWindow[]
  planPrices    MembershipPlanLocationPrice[]
  landing       LocationLanding?
}

model PractitionerLocation {
  practitionerId String
  locationId     String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  location       Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  isPrimary      Boolean             @default(false)

  @@id([practitionerId, locationId])
}

model RoomType {
  id                  String  @id @default(cuid())
  // Los tipos de sala viven dentro de cada establecimiento: precios,
  // créditos y catálogo se definen por ubicación.
  locationId          String
  location            Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  code                String // "talk" | "consult" | "premium" | "studio" — único por ubicación
  name                String // "Talk Room"
  description         String?
  creditsPerHour      Float   @default(1.0)
  baseHourlyPriceCents Int // precio por hora sin membresía
  memberHourlyPriceCents Int? // precio preferente con membresía
  capacity            Int     @default(2)
  idealFor            String[] // ["Psicología", "Coaching"]
  features            String[] // ["2 sillones", "Luz cálida", "Alta privacidad"]
  sort                Int     @default(0)
  active              Boolean @default(true)

  rooms         Room[]
  rateWindows   RateWindow[]
  demandSignals DemandSignal[]

  @@unique([locationId, code])
  @@index([locationId, active])
}

model Room {
  id                String   @id @default(cuid())
  locationId        String
  location          Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  roomTypeId        String
  roomType          RoomType @relation(fields: [roomTypeId], references: [id])
  name              String // "Talk 01"
  slug              String
  description       String?
  widthMeters       Float? // ancho en metros
  lengthMeters      Float? // largo en metros
  hourlyPriceCentsOverride Int? // override del precio base del tipo
  amenities         String[]
  photos            String[]
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  bookings  Booking[]
  recurring RecurringBooking[]
  incidents Incident[]

  @@unique([locationId, slug])
  @@index([locationId, active])
}

// ------------------------------------------------------------
// Reservas
// ------------------------------------------------------------

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  LATE_CANCELLED
  NO_SHOW
  REFUNDED
  ADMIN_BLOCKED
}

enum BookingKind {
  ROOM_RENTAL // practitioner reserva sala
  CLIENT_SESSION // cliente reserva sesión con practitioner
  ADMIN_BLOCK // bloqueo administrativo / mantenimiento
}

model Booking {
  id             String        @id @default(cuid())
  code           String        @unique // referencia corta "TP-8F3K2"
  kind           BookingKind   @default(ROOM_RENTAL)
  status         BookingStatus @default(CONFIRMED)
  locationId     String
  location       Location      @relation(fields: [locationId], references: [id])
  roomId         String?
  room           Room?         @relation(fields: [roomId], references: [id])
  practitionerId String?
  practitioner   PractitionerProfile? @relation("practitionerBookings", fields: [practitionerId], references: [id])
  clientId       String?
  client         ClientProfile? @relation("clientBookings", fields: [clientId], references: [id])
  serviceId      String?
  service        PractitionerService? @relation(fields: [serviceId], references: [id])
  createdById    String
  createdBy      User          @relation("bookingCreator", fields: [createdById], references: [id])

  startsAt   DateTime
  endsAt     DateTime
  creditsUsed Float?  // si se pagó con créditos
  priceCents  Int?    // si se pagó con dinero
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id])

  accessCode        String? // código de acceso simulado (futuro: smart lock)
  checkedInAt       DateTime?
  cancelledAt       DateTime?
  cancellationReason String?
  notes             String?
  recurringId       String?
  recurring         RecurringBooking? @relation(fields: [recurringId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditTransactions CreditTransaction[]

  // Índices críticos para detección de conflictos de horario
  @@index([roomId, startsAt, endsAt])
  @@index([roomId, status])
  @@index([practitionerId, startsAt])
  @@index([locationId, startsAt])
  @@index([status])
}

model RecurringBooking {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  roomId         String
  room           Room                @relation(fields: [roomId], references: [id])
  weekday        Int // 0 = domingo ... 6 = sábado
  startHour      Int
  endHour        Int
  active         Boolean             @default(true)
  until          DateTime?
  createdAt      DateTime            @default(now())

  bookings Booking[]
}

// Disponibilidad pública del practitioner (para su micrositio)
model Availability {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  weekday        Int
  startHour      Int
  endHour        Int
  modality       Modality            @default(IN_PERSON)

  @@index([practitionerId])
}

// ------------------------------------------------------------
// Membresías, paquetes y créditos
// ------------------------------------------------------------

enum MembershipStatus {
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

model MembershipPlan {
  id                 String        @id @default(cuid())
  code               String        @unique // "flex" | "pro" | "premium" | "resident"
  name               String // "Pro"
  tagline            String?
  monthlyPriceCents  Int
  founderPriceCents  Int? // precio especial de preventa
  includedCredits    Float         @default(0)
  rolloverLimit      Float         @default(0) // máximo de créditos que arrastran al siguiente mes
  micrositeTier      MicrositeTier @default(BASIC)
  features           String[]
  // Modelo de acceso ABIERTO: cualquier miembro reserva cualquier sala y paga
  // su tarifa de miembro (memberHourlyPriceCents). No hay gates por plan; los
  // flags primeAccess/premiumRoomAccess/studioHoursIncluded se retiraron por no
  // tener mecánica que los respaldara.
  includesLocker     Boolean       @default(false)
  highlighted        Boolean       @default(false) // "Most popular"
  sort               Int           @default(0)
  active             Boolean       @default(true)

  memberships    PractitionerMembership[]
  locationPrices MembershipPlanLocationPrice[]
}

model PractitionerMembership {
  id                 String              @id @default(cuid())
  practitionerId     String              @unique
  practitioner       PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  planId             String
  plan               MembershipPlan      @relation(fields: [planId], references: [id])
  status             MembershipStatus    @default(ACTIVE)
  isFounder          Boolean             @default(false)
  startedAt          DateTime            @default(now())
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean             @default(false)
  pausedAt           DateTime?
  cancelledAt        DateTime?

  creditTransactions CreditTransaction[]

  @@index([status, currentPeriodEnd])
}

model CreditWallet {
  id             String              @id @default(cuid())
  practitionerId String              @unique
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  // Caché denormalizado = suma de `remaining` de los lotes NO vencidos.
  // La fuente de verdad son los CreditLot; el ledger mantiene esto sincronizado.
  balance        Float               @default(0)
  updatedAt      DateTime            @updatedAt

  transactions CreditTransaction[]
  lots         CreditLot[]
}

enum CreditLotSource {
  MEMBERSHIP_GRANT
  PACKAGE_PURCHASE
  ADMIN_ADJUSTMENT
  REFUND
}

/**
 * Lote de créditos: la unidad contable real. Cada abono (membresía, paquete,
 * ajuste, reintegro) crea un lote con su propio vencimiento; el consumo es FIFO
 * (primero el que expira antes). Esto permite expirar y hacer rollover de forma
 * exacta, sin la heurística sobre la bolsa única que teníamos antes.
 */
model CreditLot {
  id            String          @id @default(cuid())
  walletId      String
  wallet        CreditWallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  source        CreditLotSource
  grantedAmount Float // monto original del lote
  remaining     Float // lo que queda por consumir
  expiresAt     DateTime? // null = sin vencimiento
  createdAt     DateTime        @default(now())
  membershipId  String? // trazabilidad al origen (si aplica)
  purchaseId    String?
  note          String?

  @@index([walletId, expiresAt])
}

enum CreditTxnType {
  PACKAGE_PURCHASE
  MEMBERSHIP_GRANT
  BOOKING_CONSUMPTION
  CANCELLATION_PENALTY
  NO_SHOW_PENALTY
  REFUND
  EXPIRATION
  ROLLOVER
  ADMIN_ADJUSTMENT
}

model CreditTransaction {
  id           String        @id @default(cuid())
  walletId     String
  wallet       CreditWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         CreditTxnType
  amount       Float // positivo = abono, negativo = cargo
  balanceAfter Float
  bookingId    String?
  booking      Booking?      @relation(fields: [bookingId], references: [id])
  purchaseId   String?
  purchase     PackagePurchase? @relation(fields: [purchaseId], references: [id])
  membershipId String?
  membership   PractitionerMembership? @relation(fields: [membershipId], references: [id])
  note         String?
  expiresAt    DateTime? // para lotes de créditos con vencimiento
  // Atribución de consumo a lotes: [{ lotId, amount }]. Permite reintegrar al
  // lote de origen al cancelar/no-show sin recalcular nada.
  lotAllocations Json?
  createdAt    DateTime      @default(now())

  @@index([walletId, createdAt])
  @@index([expiresAt])
}

model HourPackage {
  id           String  @id @default(cuid())
  code         String  @unique // "pack-10"
  name         String // "10 horas"
  hours        Float
  priceCents   Int
  validityDays Int     @default(90)
  sort         Int     @default(0)
  active       Boolean @default(true)

  purchases PackagePurchase[]
}

model PackagePurchase {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id])
  packageId      String
  package        HourPackage         @relation(fields: [packageId], references: [id])
  paymentId      String?
  payment        Payment?            @relation(fields: [paymentId], references: [id])
  creditsGranted Float
  expiresAt      DateTime?
  createdAt      DateTime            @default(now())

  creditTransactions CreditTransaction[]
}

// ------------------------------------------------------------
// Add-ons
// ------------------------------------------------------------

enum AddOnBilling {
  ONE_TIME
  MONTHLY
}

model AddOn {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  priceCents  Int
  billing     AddOnBilling @default(MONTHLY)
  sort        Int          @default(0)
  active      Boolean      @default(true)

  practitioners PractitionerAddOn[]
}

model PractitionerAddOn {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  addOnId        String
  addOn          AddOn               @relation(fields: [addOnId], references: [id])
  active         Boolean             @default(true)
  startedAt      DateTime            @default(now())
  endedAt        DateTime?

  @@index([practitionerId, active])
}

// ------------------------------------------------------------
// Servicios del practitioner (lo que ofrece a clientes finales)
// ------------------------------------------------------------

model PractitionerService {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  name           String // "Sesión individual"
  description    String?
  durationMin    Int                 @default(60)
  priceCents     Int
  modality       Modality            @default(IN_PERSON)
  active         Boolean             @default(true)
  sort           Int                 @default(0)

  bookings Booking[]
}

// ------------------------------------------------------------
// Pagos
// ------------------------------------------------------------

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentKind {
  BOOKING
  PACKAGE
  MEMBERSHIP
  ADDON
  DEPOSIT // depósito de founder en preventa
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  provider      String // "mock" | "stripe" | "mercado_pago"
  providerRef   String? // id de checkout/charge del proveedor
  idempotencyKey String?      @unique
  kind          PaymentKind
  status        PaymentStatus @default(PENDING)
  amountCents   Int
  currency      String        @default("MXN")
  refundedCents Int           @default(0)
  couponId      String?
  coupon        Coupon?       @relation(fields: [couponId], references: [id])
  description   String?
  metadata      Json?
  paidAt        DateTime?
  // Ubicación a la que se atribuye el ingreso. Se llena en los cobros nuevos;
  // para el histórico (y cobros sin sede clara) queda null y la atribución se
  // deriva de la reserva o de la sede principal del practitioner.
  locationId    String?
  location      Location?     @relation(fields: [locationId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bookings  Booking[]
  purchases PackagePurchase[]

  @@index([userId, status])
  @@index([provider, providerRef])
  @@index([locationId, status, paidAt])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  percentOff     Int? // 0-100
  amountOffCents Int?
  validFrom      DateTime?
  validUntil     DateTime?
  maxRedemptions Int?
  timesRedeemed  Int       @default(0)
  active         Boolean   @default(true)

  payments Payment[]
}

// Idempotencia de webhooks: un evento del proveedor se procesa una sola vez.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

// ------------------------------------------------------------
// Leads (preventa y contacto)
// ------------------------------------------------------------

enum LeadType {
  PRACTITIONER_APPLICATION
  CONTACT
  CLIENT_INQUIRY
}

// Pipeline comercial de preventa. Flujo founder:
// NEW → CONTACTED → QUALIFIED → (CALL_SCHEDULED) → PAYMENT_LINK_SENT
// → DEPOSIT_PAID → FOUNDER_RESERVED → CONVERTED (miembro activo).
// Salidas: NOT_COMPATIBLE (perfil no encaja), NOT_INTERESTED, LOST (genérico).
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CALL_SCHEDULED
  PAYMENT_LINK_SENT
  DEPOSIT_PAID
  FOUNDER_RESERVED
  CONVERTED
  NOT_COMPATIBLE
  NOT_INTERESTED
  LOST
}

model Lead {
  id              String     @id @default(cuid())
  type            LeadType   @default(PRACTITIONER_APPLICATION)
  status          LeadStatus @default(NEW)
  name            String
  email           String
  phone           String?
  specialty       String?
  yearsExperience Int?
  city            String?
  preferredDays   String[]
  preferredHours  String? // "Tardes 16-20h"
  weeklySessions  Int?
  hasClients      Boolean?
  roomPreference  String? // "standard" | "premium" | "studio"
  interestedPlan  String? // código del plan
  wantsLocker     Boolean?
  startTimeframe  String? // "en-cuanto-abra" | "1-3-meses" | "3-6-meses" | "explorando"
  message         String?
  source          String? // "landing-la-ceiba" | "apply" | "contact"
  // Atribución de campaña (se guardan tal cual llegan en la URL)
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  fbclid          String?
  gclid           String?
  locationId      String?
  location        Location?  @relation(fields: [locationId], references: [id])
  practitionerId  String? // si vino de un micrositio
  practitioner    PractitionerProfile? @relation("practitionerLeads", fields: [practitionerId], references: [id])
  depositCents    Int?
  adminNotes      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([type, status])
  @@index([createdAt])
}

// ------------------------------------------------------------
// Reviews
// ------------------------------------------------------------

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Review {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  clientId       String?
  client         ClientProfile?      @relation(fields: [clientId], references: [id])
  rating         Int // 1-5
  comment        String?
  consent        Boolean             @default(false) // consentimiento para publicar
  status         ReviewStatus        @default(PENDING)
  createdAt      DateTime            @default(now())

  @@index([practitionerId, status])
}

// ------------------------------------------------------------
// Documentos y verificación
// ------------------------------------------------------------

enum DocumentType {
  ID
  PROFESSIONAL_LICENSE // cédula profesional
  CERTIFICATION
  TAX_CERTIFICATE // constancia de situación fiscal
  PROFILE_PHOTO
  OTHER
}

model Document {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  type           DocumentType
  name           String
  url            String
  status         VerificationStatus  @default(PENDING_REVIEW)
  reviewedById   String?
  reviewedBy     User?               @relation("documentReviewer", fields: [reviewedById], references: [id])
  reviewNotes    String?
  expiresAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([practitionerId])
  @@index([status])
}

// ------------------------------------------------------------
// Micrositios
// ------------------------------------------------------------

model Microsite {
  id             String              @id @default(cuid())
  practitionerId String              @unique
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  tier           MicrositeTier       @default(BASIC)
  published      Boolean             @default(false)
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  showPrices     Boolean             @default(true)
  showReviews    Boolean             @default(true)
  allowBooking   Boolean             @default(false) // reservas directas de clientes
  allowContact   Boolean             @default(true)
  accentTheme    String?             @default("ink") // personalización discreta
  customSections Json?
  updatedAt      DateTime            @updatedAt
}

// ------------------------------------------------------------
// Lockers e incidencias
// ------------------------------------------------------------

enum LockerSize {
  SMALL
  LARGE
}

enum LockerStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
}

model Locker {
  id                String       @id @default(cuid())
  locationId        String
  location          Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  number            String
  size              LockerSize   @default(SMALL)
  status            LockerStatus @default(AVAILABLE)
  // Nullable desde 2026-07: el locker va incluido sin costo en toda
  // membresía; el precio aplica solo si se renta suelto.
  monthlyPriceCents Int?
  assignedToId      String?
  assignedTo        PractitionerProfile? @relation(fields: [assignedToId], references: [id])
  assignedAt        DateTime?

  @@unique([locationId, number])
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Incident {
  id           String           @id @default(cuid())
  locationId   String
  location     Location         @relation(fields: [locationId], references: [id])
  roomId       String?
  room         Room?            @relation(fields: [roomId], references: [id])
  reportedById String
  reportedBy   User             @relation("incidentReporter", fields: [reportedById], references: [id])
  title        String
  description  String?
  priority     IncidentPriority @default(MEDIUM)
  status       IncidentStatus   @default(OPEN)
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([locationId, status])
}

// ------------------------------------------------------------
// Notificaciones, settings y auditoría
// ------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "booking_confirmed" | "payment_failed" | ...
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// Configuración global u operativa por ubicación (key-value tipado por JSON)
model Setting {
  id         String  @id @default(cuid())
  key        String
  locationId String? // null = global
  value      Json
  updatedAt  DateTime @updatedAt

  // El @@unique compuesto no cubre los globales (en Postgres NULL != NULL, así
  // que permitiría filas key+NULL duplicadas). El unicidad de globales la
  // garantiza el índice parcial `setting_key_global ON (key) WHERE locationId
  // IS NULL`, creado por migración manual (no expresable en el schema de Prisma).
  @@unique([key, locationId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("actor", fields: [actorId], references: [id])
  action    String // "practitioner.approved", "booking.cancelled_by_admin"
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ------------------------------------------------------------
// Costos y rentabilidad
// Sin gastos no hay margen: estos modelos permiten calcular
// utilidad y punto de equilibrio por ubicación y de toda la red.
// ------------------------------------------------------------

enum ExpenseCategory {
  RENT
  UTILITIES // luz, agua, internet
  PAYROLL // nómina (se alimenta también de Employee)
  MAINTENANCE
  CLEANING
  SUPPLIES
  MARKETING
  SOFTWARE
  INSURANCE
  TAXES
  OTHER
}

enum ExpenseRecurrence {
  ONE_TIME
  MONTHLY
  YEARLY
}

/// Naturaleza del gasto, eje independiente de la recurrencia: la renta es fija
/// y mensual; la luz es variable y mensual; una reparación es variable y única.
enum ExpenseKind {
  FIXED
  VARIABLE
}

model Expense {
  id          String            @id @default(cuid())
  // null = gasto corporativo, no atribuible a una sede concreta.
  locationId  String?
  location    Location?         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  recurrence  ExpenseRecurrence @default(MONTHLY)
  kind        ExpenseKind       @default(FIXED)
  concept     String
  amountCents Int
  // Recurrentes: ventana de vigencia (effectiveTo null = vigente).
  // Únicos: la fecha real del gasto en incurredAt.
  effectiveFrom DateTime        @default(now())
  effectiveTo   DateTime?
  incurredAt    DateTime?
  vendor      String?
  notes       String?
  active      Boolean           @default(true)
  // Quién lo registró: la bitácora de gastos necesita responsable.
  createdById String?
  createdBy   User?             @relation("expenseAuthor", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  receipts ExpenseReceipt[]

  @@index([locationId, active])
  @@index([category, active])
  @@index([kind, active])
  @@index([incurredAt])
}

/// Comprobante de un gasto (factura, recibo, ticket). El archivo vive en el
/// proveedor de storage; aquí solo la referencia y su metadata.
model ExpenseReceipt {
  id           String   @id @default(cuid())
  expenseId    String
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  url          String
  filename     String
  contentType  String?
  sizeBytes    Int?
  uploadedById String?
  uploadedBy   User?    @relation("receiptUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([expenseId])
}

// ------------------------------------------------------------
// Equipo por ubicación (nómina propia de The Practice, no practitioners)
// ------------------------------------------------------------

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmployeeDocumentType {
  CONTRACT
  ID
  TAX_ID // RFC / constancia de situación fiscal
  SOCIAL_SECURITY // IMSS
  BANK_DETAILS
  MEDICAL_CERT
  TRAINING
  NDA
  OTHER
}

model Employee {
  id                 String         @id @default(cuid())
  locationId         String
  location           Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  // Opcional: si además tiene cuenta en la plataforma.
  userId             String?        @unique
  user               User?          @relation(fields: [userId], references: [id])
  name               String
  position           String // "Recepción", "Coordinación de operaciones"
  email              String?
  phone              String?
  employmentType     EmploymentType @default(FULL_TIME)
  status             EmployeeStatus @default(ACTIVE)
  monthlySalaryCents Int?
  startedAt          DateTime
  endedAt            DateTime?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  documents EmployeeDocument[]

  @@index([locationId, status])
}

model EmployeeDocument {
  id         String               @id @default(cuid())
  employeeId String
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       EmployeeDocumentType
  name       String
  url        String
  // Vencimiento: alimenta las alertas de documentación por vencer.
  expiresAt  DateTime?
  status     VerificationStatus   @default(PENDING_REVIEW)
  notes      String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([employeeId])
  @@index([expiresAt])
}

// ------------------------------------------------------------
// Demanda insatisfecha
// Registra lo que se pidió y NO se pudo dar: es la señal más honesta
// para decidir conversiones de sala, horarios y precios.
// ------------------------------------------------------------

enum DemandReason {
  NO_AVAILABILITY // el tipo de sala existe pero estaba ocupado
  NO_ROOM_TYPE // la ubicación no ofrece ese tipo de sala
  OUTSIDE_HOURS // fuera del horario de operación
  PRICE // desistió por precio
}

model DemandSignal {
  id             String               @id @default(cuid())
  locationId     String
  location       Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  roomTypeId     String?
  roomType       RoomType?            @relation(fields: [roomTypeId], references: [id])
  practitionerId String?
  practitioner   PractitionerProfile? @relation(fields: [practitionerId], references: [id])
  reason         DemandReason
  requestedStart DateTime?
  requestedEnd   DateTime?
  // Desnormalizados para agrupar por franja sin recalcular en cada consulta.
  weekday        Int? // 0 = domingo … 6 = sábado
  hour           Int?
  notes          String?
  createdAt      DateTime             @default(now())

  @@index([locationId, createdAt])
  @@index([roomTypeId, reason])
  @@index([weekday, hour])
}

// ------------------------------------------------------------
// Flexibilidad de precios
// ------------------------------------------------------------

enum RateWindowKind {
  PRIME // horas de mayor demanda: sobreprecio
  OFF_PEAK // horas valle: descuento para llenar
}

/// Franja horaria con tarifa distinta. Aplica a un tipo de sala concreto o a
/// todos los de la ubicación (roomTypeId null). El ajuste puede ser un
/// multiplicador (multiplierBps: 12000 = 120% del precio base) o un precio
/// fijo. Si dos franjas coinciden, gana la de mayor `priority`.
model RateWindow {
  id              String         @id @default(cuid())
  locationId      String
  location        Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  roomTypeId      String?
  roomType        RoomType?      @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  kind            RateWindowKind
  label           String // "Tardes prime", "Mañanas valle"
  weekdays        Int[] // 0 = domingo … 6 = sábado
  startHour       Int
  endHour         Int
  multiplierBps   Int? // 10000 = sin cambio
  fixedPriceCents Int?
  creditsPerHour  Float? // permite que la franja cueste más créditos
  priority        Int            @default(0)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([locationId, active])
  @@index([roomTypeId, active])
}

/// Precio de un plan en una ubicación concreta. Los planes son globales; esto
/// permite que una sede tenga precio distinto sin duplicar el catálogo.
model MembershipPlanLocationPrice {
  id                String         @id @default(cuid())
  planId            String
  plan              MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  locationId        String
  location          Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  monthlyPriceCents Int
  founderPriceCents Int?
  includedCredits   Float?
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([planId, locationId])
  @@index([locationId, active])
}

// ------------------------------------------------------------
// Roles y facultades (RBAC)
// El enum UserRole sigue siendo la compuerta gruesa (dashboard que te toca);
// estos modelos añaden facultades finas que el super admin activa o desactiva
// desde una matriz. El catálogo de facultades vive en código
// (src/lib/permissions.ts): así una facultad nueva no requiere migración y
// nunca hay permisos "huérfanos" apuntando a funciones que ya no existen.
// ------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  slug        String   @unique // "operaciones", "finanzas"
  name        String
  description String?
  /// Los roles de sistema no se pueden borrar (evita quedarse sin acceso).
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]

  @@index([active])
}

/// Una facultad concedida a un rol. `permission` es la clave del catálogo en
/// código; guardar solo lo concedido hace que el default sea negar.
model RolePermission {
  id         String   @id @default(cuid())
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now())

  @@unique([roleId, permission])
  @@index([roleId])
}

/// Excepción para una persona concreta, por encima de su rol: permite conceder
/// o quitar una facultad puntual sin inventar un rol nuevo.
model UserPermissionOverride {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  /// true = concedida aunque el rol no la tenga; false = revocada aunque sí.
  allowed    Boolean
  note       String?
  createdAt  DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

// ------------------------------------------------------------
// Contenido de landing por ubicación
// La landing comercial es una plantilla: su contenido vive aquí, no en el
// código, para que cualquier sede futura tenga la suya sin programar.
// ------------------------------------------------------------

model LocationLanding {
  id         String   @id @default(cuid())
  locationId String   @unique
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// Si está apagada, la ruta pública responde 404.
  published  Boolean  @default(false)

  // Hero
  eyebrow      String? // "Preventa Founder"
  headline     String? // titular principal
  subheadline  String?
  heroImageUrl String?
  primaryCtaLabel   String?
  secondaryCtaLabel String?
  supportText  String? // "Aplicación gratuita · Cupo limitado"

  /// Zona o referencia de ubicación que se muestra al público (p. ej. una
  /// colonia), separada de la dirección exacta.
  zone String?

  // Bloques de contenido variables por sede. Cada bloque es
  // { type, title, description, items[] } — se documenta en src/lib/landing.ts
  sections Json?

  // SEO
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?

  /// WhatsApp de seguimiento de esta sede; si es null se usa el global.
  whatsappPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
